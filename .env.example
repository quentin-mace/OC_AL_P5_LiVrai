# Copier ce fichier en .env et renseigner vos propres valeurs.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=livrai
MYSQL_USER=livrai
MYSQL_PASSWORD=change-me

# Port MySQL exposé sur la machine hôte (pour un client SQL externe).
# 3307 par défaut, car 3306 est souvent déjà pris par un MySQL installé localement.
DB_HOST_PORT=3307

# Port HTTP exposé sur la machine hôte.
APP_HOST_PORT=8080
